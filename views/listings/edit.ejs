<% layout("/layouts/boilerplate") %>
      <div class="row mb-3">

        <div class="col-8 offset-2">
            <br><br>


    <h3>Edit your Listings</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
            <label for="text" class="form label">Title</label>
            <input type="text" name="listing[title]"  class="form-control" value="<%= listing.title %>" required>
               <!--This is refer to valid text appear during the submit form-->
             <div class="valid-feedback">Title looks good!</div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Desciption</label>
            <textarea name="listing[description]"  type="text" class="form-control" required> <%= listing.description %></textarea>
             <div class="invalid-feedback">Please enter a short description</div>
        </div>

        <div class="mb-3">
            Original listing Image:<br/>
         <img src="<%= originalImageUrl %>" alt="Original listing image"
              width="250" height="200" style="width: 250px; height: 200px; object-fit: cover;">
        </div>

        <div class="mb-3">
            <label for="image-link" class="form-label">Upload New Image </label>
            <input type="file" name="listing[image]" class="form-control">
        </div>

        <div class="row">

        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input type="number" name="listing[price]" class="form-control" value="<%= listing.price %>" min="0" step="1" required>
               <div class="invalid-feedback">Price should be valid</div>
        </div>

        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" class="form-control" value="<%= listing.country %>" required>
             <div class="invalid-feedback">Country should be valid</div>
        </div>

        </div>

       

        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" class="form-control" value="<%= listing.location %>" required>
            <div class="invalid-feedback">Location should be valid</div>
        </div>

       
        <button class="btn  btn-dark  edit-btn mt-3">Edit</button>
       
      
    </form>

         </div>

    </div>
  
